---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import HorizontalScroll from "@/components/HorizontalScroll.astro";
import heroPoster from "@/assets/plaza-hero.png";
import { getFeaturedProjects } from "@/data/projects.js";

const featured = getFeaturedProjects();
---

<BaseLayout
  title="פלאזה יזמות והתחדשות עירונית | התחדשות עירונית"
  description="פלאזה יזמות והתחדשות עירונית, בשיתוף קבוצת טל שג — מובילים את העתיד של ההתחדשות העירונית בישראל. פינוי-בינוי, שקיפות ושותפות אמיתית עם הדיירים."
  image={heroPoster}
>
  <main id="main-content">
  <h1 class="sr-only">פלאזה יזמות והתחדשות עירונית — מובילים את העתיד של ההתחדשות העירונית</h1>

  <!-- HERO -->
  <section class="relative flex min-h-[100svh] w-full items-center overflow-hidden">
    <video
      src="/hero.mp4"
      poster={heroPoster.src}
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"
      data-hero-video
      class="absolute inset-0 h-full w-full object-cover"
    ></video>
    <div
      aria-hidden="true"
      class="absolute inset-0"
      style="background: linear-gradient(to left, var(--color-base) 0%, color-mix(in oklab, var(--color-base) 72%, transparent) 40%, color-mix(in oklab, var(--color-base) 20%, transparent) 70%, transparent 100%)"
    ></div>
    <div
      aria-hidden="true"
      class="absolute inset-x-0 bottom-0 h-40"
      style="background: linear-gradient(180deg, transparent, var(--color-base))"
    ></div>
    <div class="relative z-[1] mx-auto w-full max-w-screen-xl px-6">
      <div class="max-w-[520px]">
        <div class="editorial-frame mb-9 bg-base/60 backdrop-blur-sm">התחדשות עירונית</div>
        <h2 class="text-balance font-serif text-[clamp(2.6rem,6vw,4.6rem)] font-light leading-[1.05]">
          מובילים את העתיד
          <br />
          <span class="text-accent">של ההתחדשות העירונית.</span>
        </h2>
        <p class="mt-9 max-w-[50ch] text-lg leading-[1.9] text-faded md:text-xl">
          פלאזה יזמות והתחדשות עירונית, בשיתוף קבוצת טל שג, מביאה שילוב בין ניסיון מוכח, חשיבה חדשה ושותפות אמיתית עם הדיירים.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-8">
          <a
            href="/contact"
            class="group inline-flex items-center gap-3 rounded-full bg-accent px-8 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-[var(--gradient-mid)]"
          >
            בדיקת התאמה לפרויקט
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">←</span>
          </a>
          <a href="/#about" class="text-[11px] uppercase tracking-[0.2em] text-faded transition-colors hover:text-ink">
            הגישה שלנו ←
          </a>
        </div>
      </div>
    </div>
    <noscript>
      <Image
        src={heroPoster}
        alt="חזון פלאזה — בניינים מודרניים והתחדשות עירונית"
        width={1600}
        height={1200}
        format="png"
        loading="eager"
        class="absolute inset-0 h-full w-full object-cover"
      />
    </noscript>
  </section>

  <script is:inline>
    (() => {
      const video = document.querySelector("[data-hero-video]");
      if (video && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        video.pause();
      }
    })();
  </script>

  <!-- ABOUT -->
  <section id="about" class="mx-auto max-w-screen-xl px-6 pb-28 pt-20 md:pt-28">
    <div class="grid items-center gap-14 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-5">
        <div class="editorial-frame mb-8">הגישה שלנו</div>
        <h2 class="text-balance font-serif text-[clamp(2rem,4vw,3.2rem)] font-light leading-[1.15]">
          התחדשות עירונית
          <span class="text-accent">מתחילה באנשים.</span>
        </h2>
      </div>
      <div class="md:col-span-6 md:col-start-7">
        <p class="text-lg leading-[1.9] text-faded">
          פלאזה מאמינה שהתחדשות עירונית מתחילה באנשים. הדיירים הם שותפים מלאים לתהליך, ולכן אנו שמים דגש על שקיפות, הקשבה, ליווי אישי ויצירת אמון — מהרגע הראשון ועד למסירת המפתחות.
        </p>
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="mx-auto max-w-screen-xl px-6 pb-28">
    <div class="border-t border-line pt-14">
      <div class="editorial-frame mb-12">הערכים שלנו</div>
      <div class="grid gap-x-10 gap-y-14 md:grid-cols-2 lg:grid-cols-4">
        {
          [
            {
              word: "שקיפות",
              copy: "תקשורת ברורה ופתוחה לאורך כל שלבי הפרויקט. בלי הפתעות, בלי אותיות קטנות.",
            },
            {
              word: "הקשבה",
              copy: "הבנת הצרכים והרצונות של בעלי הדירות — מכל שלב ועד למסירת המפתחות.",
            },
            {
              word: "ליווי אישי",
              copy: "מלווים את הדיירים בכל צעד בתהליך, בזמינות ובשירות מלא.",
            },
            {
              word: "אמון",
              copy: "בניית יחסים חזקים ואמינים עם כל דייר ודיירת, לאורך כל הדרך.",
            },
          ].map((item) => (
            <div class="space-y-4">
              <div class="editorial-rule"></div>
              <h3 class="font-serif text-2xl font-light">{item.word}</h3>
              <p class="text-sm leading-relaxed text-faded">{item.copy}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FEATURED PROJECTS: PINNED HORIZONTAL SCROLL -->
  <section class="relative mt-24">
    <div class="mx-auto max-w-screen-xl px-6">
      <div class="mb-14 flex flex-wrap items-end justify-between gap-6 border-t border-line pt-12">
        <div class="editorial-number mb-6">01</div>
          <h2 class="max-w-[22ch] text-balance font-serif text-[clamp(2rem,4vw,3.4rem)] font-light leading-[1.1]">
            מהשטח
            <span class="text-accent">אל העתיד.</span>
          </h2>
        </div>
        <p class="hidden max-w-[36ch] text-sm leading-relaxed text-faded md:block">
          המשיכו לגלול — הרשימה נעה איתכם.
        </p>
      </div>
    </div>

    <HorizontalScroll ariaLabel="רשימת פרויקטים נבחרים">
      {
        featured.map((project) => (
          <article class="group w-[78vw] flex-none sm:w-[52vw] md:w-[44vw] lg:w-[36vw]">
            <a href="/projects" class="block">
              <div class="relative overflow-hidden rounded-[min(1vw,12px)] bg-paper">
                {
                  project.image && (
                    <Image
                      src={project.image}
                      alt={project.name}
                      width={900}
                      height={675}
                      loading="lazy"
                      class="aspect-[4/3] w-full object-cover transition-transform duration-[1600ms] ease-out group-hover:scale-[1.04]"
                    />
                  )
                }
              </div>
              <div class="mt-5 flex items-baseline justify-between gap-4 border-b border-line pb-4">
                <h3 class="font-serif text-2xl font-light">{project.name}</h3>
              </div>
            </a>
          </article>
        ))
      }
    </HorizontalScroll>
  </section>

  <!-- PARTNERSHIP -->
  <section id="partnership" class="mx-auto max-w-screen-xl px-6 pb-28 pt-16">
    <div class="grid items-start gap-14 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-5">
        <div class="editorial-frame mb-8">שותפות</div>
        <h2 class="text-balance font-serif text-[clamp(2rem,4vw,3.2rem)] font-light leading-[1.15]">
          הניסיון שמאחורי
          <span class="text-accent">הדרך.</span>
        </h2>
      </div>
      <div class="md:col-span-6 md:col-start-7">
        <p class="text-lg leading-[1.9] text-faded">
          קבוצת טל שג מביאה ניסיון רב שנים בעולם הבנייה והיזמות, כולל פעילות בפרויקטים משמעותיים בישראל ובשיתופי פעולה עם חברות מובילות כגון קבוצת אזורים.
        </p>
        <blockquote class="mt-12">
          <div class="editorial-rule mb-8"></div>
          <p class="text-balance font-serif text-2xl font-light leading-[1.35] md:text-3xl">
            "הניסיון של טל שג עם הגישה החדשנית של פלאזה
            <span class="text-accent">יוצר שילוב של עוצמה.</span>"
          </p>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="dark-band px-6 py-28 md:py-36">
    <span class="editorial-bg-word" aria-hidden="true">פלאזה</span>
    <div class="relative z-[1] mx-auto max-w-screen-xl text-center">
      <div class="mx-auto max-w-2xl space-y-8">
        <div class="editorial-frame editorial-frame--dark mb-10">צרו קשר</div>
        <h2 class="text-balance font-serif text-[clamp(2rem,4vw,3.2rem)] font-light leading-[1.15]">
          ניסיון חזק מאחורינו.
          <br />
          <span class="text-[var(--gradient-start)]">שותפות אמיתית לפנינו.</span>
        </h2>
        <p class="mx-auto max-w-[52ch] text-sm leading-relaxed text-base/60">
          מעוניינים לשמוע עוד? צרו קשר ובדקו התאמה לפרויקט שלכם. אנחנו כאן בשבילכם.
        </p>
        <div class="flex flex-col items-center gap-6 pt-2 sm:flex-row sm:justify-center">
          <a
            href="/contact"
            class="group inline-flex items-center gap-3 rounded-full bg-accent px-8 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-[var(--gradient-mid)]"
          >
            בדיקת התאמה לפרויקט
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">←</span>
          </a>
          <a
            href="mailto:OFFICE@PLAZA-IL.COM"
            class="inline-flex items-center gap-3 rounded-full border border-base/25 px-8 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-base transition-colors hover:border-base/60"
          >
            OFFICE@PLAZA-IL.COM
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- JSON-LD -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "פלאזה יזמות והתחדשות עירונית",
    url: Astro.site?.href ?? "https://plaza-il.com/",
    description: "פלאזה יזמות והתחדשות עירונית — פינוי-בינוי ויצירת פתרונות מגורים חדשים בישראל.",
    address: {
      "@type": "PostalAddress",
      streetAddress: "רמת הגולן 6",
      addressLocality: "ירושלים",
      addressCountry: "IL",
    },
    email: "OFFICE@PLAZA-IL.COM",
  })}></script>
  </main>
</BaseLayout>
