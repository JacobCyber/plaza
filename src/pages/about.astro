---
import BaseLayout from "@/layouts/BaseLayout.astro";

const team = [
  {
    name: "טדי ליכטשיין",
    role: "יו\"ר הדירקטוריון – קבוצת טל שג",
    description: "מוביל את הדירקטוריון ומביא עמו ניסיון רב בניהול והובלת מהלכים עסקיים ופרויקטים משמעותיים בתחום היזמות והבנייה.",
  },
  {
    name: "אנטוני הלר",
    role: "יו\"ר פלאזה אינטרנשיונל",
    description: "מוביל את הפעילות הבינלאומית של קבוצת פלאזה ומביא ראייה גלובלית וניסיון בתחום הנדל\"ן והפיתוח.",
  },
  {
    name: "שימי גרוסמן",
    role: "מנכ"ל – קבוצת טל שג",
    description: "שותף מרכזי בפעילות הקבוצה, בעל מעורבות בהובלת תהליכים עסקיים ופרויקטים בתחום ההתחדשות העירונית.",
  },
  {
    name: "נתן אוירבך",
    role: "סמנכ\"ל",
    description: "אחראי על ניהול והובלת תהליכים מרכזיים בחברה, תוך דגש על מקצועיות, ביצוע ותיאום בין הגורמים השונים.",
  },
  {
    name: "גב וולמן",
    role: "מנכ\"ל – פלאזה יזמות והתחדשות עירונית",
    description: "מוביל את פעילות החברה, את הקשר עם הדיירים ואת יישום החזון של פלאזה בתחום ההתחדשות העירונית.",
  },
  {
    name: "יצחק שטרן",
    role: "יועץ משפטי",
    description: "מלווה את פעילות החברה מהבחינה המשפטית ומעניק מעטפת מקצועית לתהליכי ההתחדשות העירונית.",
  },
  {
    name: "מתס ליכטשיין",
    role: "מנהל פרויקטים",
    description: "אחראי על ניהול וקידום פרויקטים, תוך שמירה על איכות, תכנון מדויק ועמידה ביעדים.",
  },
  {
    name: "דביר ציפל",
    role: "סמנכ\"ל כספים",
    description: "אחראי על ניהול המערך הפיננסי של החברה, בקרה תקציבית ותכנון פיננסי ארוך טווח.",
  },
];
---

<BaseLayout
  title="אודותינו | פלאזה יזמות והתחדשות עירונית"
  description="הנהלת פלאזה יזמות והתחדשות עירונית — הצוות שמוביל את החזון של התחדשות עירונית בישראל."
>
  <main id="main-content">
  <section class="mx-auto max-w-screen-xl px-6 pb-16 pt-20 md:pb-24 md:pt-28">
    <p class="mb-6 flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded">
      <span class="inline-block h-px w-8 bg-ink/40"></span>
      אודותינו
    </p>
    <h1 class="max-w-[18ch] text-balance font-serif text-5xl leading-[0.95] md:text-7xl">
      הנהלת
      <span class="text-accent">החברה.</span>
    </h1>
    <p class="mt-8 max-w-[58ch] text-lg leading-relaxed text-faded">
      האנשים שמובילים את החזון.
    </p>
  </section>

  <!-- INTRO -->
  <section class="mx-auto max-w-screen-xl px-6 pb-20">
    <div class="grid gap-10 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-5">
        <p class="text-lg leading-relaxed text-faded">
          מאחורי פלאזה יזמות והתחדשות עירונית עומדת הנהלה מקצועית המשלבת ניסיון רב שנים ביזמות, בנייה, פיננסים, משפט וניהול פרויקטים.
        </p>
      </div>
      <div class="md:col-span-6 md:col-start-7">
        <p class="text-lg leading-relaxed text-faded">
          הצוות שלנו מחבר בין ראייה אסטרטגית, יכולות ביצוע מוכחות ומחויבות אמיתית לשותפות עם הדיירים.
        </p>
      </div>
    </div>
  </section>

  <!-- TEAM GRID -->
  <section class="mx-auto max-w-screen-xl px-6 pb-32">
    <div class="border-t border-line pt-12">
      <p class="mb-12 text-[11px] uppercase tracking-[0.3em] text-faded">
        <span class="inline-block h-px w-8 bg-ink/40"></span>
        הצוות
      </p>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {team.map((member, i) => (
          <div class="group space-y-4">
            <div class="aspect-[3/4] overflow-hidden rounded-[min(1vw,12px)] bg-paper">
              <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-paper to-[var(--color-line)] p-6">
                <span class="font-serif text-5xl text-accent/30 tabular-nums">{String(i + 1).padStart(2, "0")}</span>
              </div>
            </div>
            <div class="space-y-1">
              <h3 class="font-serif text-xl">{member.name}</h3>
              <p class="text-[11px] uppercase tracking-[0.2em] text-accent">{member.role}</p>
            </div>
            <p class="text-sm leading-relaxed text-faded">{member.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-screen-xl px-6 pb-32">
    <div class="rounded-[min(1vw,16px)] bg-paper px-8 py-12 text-center md:px-16">
      <h2 class="text-balance font-serif text-2xl md:text-3xl">
        רוצים להכיר אותנו מקרוב?
      </h2>
      <p class="mx-auto mt-3 max-w-[48ch] text-sm text-faded">
        צרו קשר ונתאם פגישת היכרות.
      </p>
      <a
        href="/contact"
        class="mt-6 inline-flex items-center gap-3 rounded-full bg-accent px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-[var(--gradient-mid)]"
      >
        צור קשר
        <span aria-hidden="true">←</span>
      </a>
    </div>
  </section>
  </main>
</BaseLayout>
