---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { projects } from "@/data/projects.js";
import plazaLogo from "@/assets/logo.png";

const numbered = projects.map((project, i) => ({ ...project, n: String(i + 1).padStart(2, "0") }));
---

<BaseLayout
  title="פרויקטים | פלאזה יזמות והתחדשות עירונית"
  description="הפרויקטים של פלאזה יזמות והתחדשות עירונית וקבוצת טל שג בישראל ובקנדה — ניסיון מוכח בתחום ההתחדשות העירונית והבנייה למגורים."
>
  <main id="main-content">
  <section class="editorial relative overflow-hidden pb-10 pt-24 md:pt-32">
    <span class="editorial-bg-word" aria-hidden="true">פרויקטים</span>
    <div class="relative z-[1] mx-auto max-w-screen-xl px-6">
      <div class="editorial-frame mb-9">הפרויקטים שלנו</div>
      <h1 class="max-w-[20ch] text-balance font-serif text-[clamp(2.6rem,6vw,4.6rem)] font-light leading-[1.05]">
        מהשטח
        <span class="text-accent">אל העתיד.</span>
      </h1>
      <p class="mt-8 max-w-[58ch] text-lg leading-[1.9] text-faded">
        ניסיון מוכח בישראל ובקנדה. פלאזה וקבוצת טל שג מובילות פרויקטים משמעותיים בתחום ההתחדשות העירונית והבנייה למגורים.
      </p>
    </div>
  </section>

  <!-- PROJECTS GRID -->
  <section class="mx-auto max-w-screen-xl px-6 pb-28 pt-16">
    <div class="grid grid-cols-1 gap-x-10 gap-y-16 sm:grid-cols-2 lg:grid-cols-3">
      {
        numbered.map((project) => (
          <article class="group flex flex-col">
            {
              project.image ? (
                <a href="/contact" class="block" tabindex="-1" aria-hidden="true">
                  <div class="relative overflow-hidden rounded-[min(1vw,12px)] bg-paper">
                    <Image
                      src={project.image}
                      alt=""
                      width={1000}
                      height={750}
                      loading="lazy"
                      class="aspect-[4/3] w-full object-cover transition-transform duration-[1600ms] ease-out group-hover:scale-[1.04]"
                    />
                    <div class="absolute inset-x-0 bottom-0 p-6" style="background: linear-gradient(to top, rgba(27,26,22,0.6) 0%, transparent 70%)"></div>
                    <span class="absolute top-4 right-4 font-serif text-sm tabular-nums text-base/80">{project.n}</span>
                  </div>
                </a>
              ) : (
                <a href="/contact" class="block" tabindex="-1" aria-hidden="true">
                  <div class="relative flex aspect-[4/3] items-center justify-center overflow-hidden rounded-[min(1vw,12px)] border border-line bg-paper p-10 transition-colors duration-500 group-hover:border-accent">
                    <span class="absolute top-4 right-4 font-serif text-sm tabular-nums text-accent/60">{project.n}</span>
                    <Image
                      src={plazaLogo}
                      alt=""
                      width={320}
                      height={120}
                      loading="lazy"
                      class="w-full max-w-[62%] object-contain opacity-80 transition-all duration-500 group-hover:opacity-100"
                    />
                  </div>
                </a>
              )
            }
            <div class="mt-5 flex items-baseline justify-between gap-4 border-b border-line pb-4">
              <h2 class="font-serif text-2xl font-light">{project.name}</h2>
              <a href="/contact" class="text-[10px] uppercase tracking-[0.3em] text-accent opacity-0 transition-opacity duration-500 group-hover:opacity-100">
                לפרויקט
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- DARK CTA BAND -->
  <section class="dark-band px-6 py-28 md:py-36">
    <span class="editorial-bg-word" aria-hidden="true">פרויקטים</span>
    <div class="relative z-[1] mx-auto max-w-screen-xl text-center">
      <div class="mx-auto max-w-2xl space-y-8">
        <div class="editorial-frame editorial-frame--dark mb-10">מעבר לפרויקט</div>
        <h2 class="text-balance font-serif text-[clamp(2rem,4vw,3.2rem)] font-light leading-[1.15]">
          לכל פרויקט
          <span class="text-[var(--gradient-start)]">יש סיפור.</span>
        </h2>
        <p class="mx-auto max-w-[52ch] text-sm leading-relaxed text-base/60">
          צרו קשר לקבלת מידע נוסף על הפרויקטים שלנו.
        </p>
        <div class="flex flex-col items-center gap-6 pt-2 sm:flex-row sm:justify-center">
          <a
            href="/contact"
            class="group inline-flex items-center gap-3 rounded-full bg-accent px-8 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-[var(--gradient-mid)]"
          >
            צור קשר
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">←</span>
          </a>
          <a
            href="mailto:OFFICE@PLAZA-IL.COM"
            class="inline-flex items-center gap-3 rounded-full border border-base/25 px-8 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-base transition-colors hover:border-base/60"
          >
            OFFICE@PLAZA-IL.COM
          </a>
        </div>
      </div>
    </div>
  </section>
  </main>
</BaseLayout>
