---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import HorizontalScroll from "@/components/HorizontalScroll.astro";
import { projects, getFeaturedProjects } from "@/data/projects.js";

const featured = getFeaturedProjects();
const rest = projects.filter((p) => !p.image);
---

<BaseLayout
  title="פרויקטים | פלאזה יזמות והתחדשות עירונית"
  description="הפרויקטים של פלאזה יזמות והתחדשות עירונית וקבוצת טל שג בישראל ובקנדה — ניסיון מוכח בתחום ההתחדשות העירונית והבנייה למגורים."
>
  <main id="main-content">
  <section class="editorial relative overflow-hidden pb-10 pt-24 md:pt-32">
    <span class="editorial-bg-word" aria-hidden="true">פרויקטים</span>
    <div class="relative z-[1] mx-auto max-w-screen-xl px-6">
      <div class="editorial-frame mb-9">הפרויקטים שלנו</div>
      <h1 class="max-w-[20ch] text-balance font-serif text-[clamp(2.6rem,6vw,4.6rem)] font-light leading-[1.05]">
        מהשטח
        <span class="text-accent">אל העתיד.</span>
      </h1>
      <p class="mt-8 max-w-[58ch] text-lg leading-[1.9] text-faded">
        ניסיון מוכח בישראל ובקנדה. פלאזה וקבוצת טל שג מובילות פרויקטים משמעותיים בתחום ההתחדשות העירונית והבנייה למגורים.
      </p>
    </div>
  </section>

  <!-- PINNED HORIZONTAL SCROLL GALLERY -->
  <section class="relative mt-16">
    <HorizontalScroll ariaLabel="גלריית פרויקטים">
      {
        featured.map((project) => (
          <article class="group w-[80vw] flex-none sm:w-[52vw] md:w-[42vw] lg:w-[36vw]">
            <div class="relative overflow-hidden rounded-[min(1vw,12px)] bg-paper">
              {
                project.image && (
                  <Image
                    src={project.image}
                    alt={project.name}
                    width={1000}
                    height={750}
                    loading={project === featured[0] ? "eager" : "lazy"}
                    class="aspect-[4/3] w-full object-cover transition-transform duration-[1600ms] ease-out group-hover:scale-[1.04]"
                  />
                )
              }
              <div class="absolute inset-x-0 bottom-0 p-6" style="background: linear-gradient(to top, rgba(34,33,29,0.6) 0%, transparent 70%)"></div>
            </div>
            <div class="mt-5 flex items-baseline justify-between gap-4 border-b border-line pb-4">
              <h2 class="font-serif text-2xl font-light md:text-3xl">{project.name}</h2>
              <p class="text-[10px] uppercase tracking-[0.3em] text-accent">
                {project.region === "israel" ? "ישראל" : "קנדה"}
              </p>
            </div>
          </article>
        ))
      }
    </HorizontalScroll>
  </section>

  <!-- ALL PROJECTS LIST -->
  <section class="mx-auto max-w-screen-xl px-6 pb-28 pt-10">
    <div class="border-t border-line pt-14">
      <div class="editorial-frame mb-12">כל הפרויקטים</div>
      <div class="grid grid-cols-1 gap-x-12 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((project) => (
            <div class="group flex items-baseline justify-between gap-4 border-b border-line/60 py-4 transition-colors hover:border-accent">
              <p class="font-serif text-xl font-light">{project.name}</p>
              <p class="text-[10px] uppercase tracking-[0.3em] text-accent">
                {project.region === "israel" ? "ישראל" : "קנדה"}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-24 text-center">
      <h2 class="text-balance font-serif text-3xl font-light md:text-4xl">
        רוצים לשמוע על
        <span class="text-accent">הפרויקטים שלנו?</span>
      </h2>
      <p class="mx-auto mt-4 max-w-[48ch] text-sm text-faded">
        צרו קשר לקבלת מידע נוסף.
      </p>
      <a
        href="/contact"
        class="group mt-8 inline-flex items-center gap-3 rounded-full bg-accent px-8 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-[var(--gradient-mid)]"
      >
        צור קשר
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">←</span>
      </a>
    </div>
  </section>
  </main>
</BaseLayout>
