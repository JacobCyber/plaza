---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="צור קשר | פלאזה יזמות והתחדשות עירונית"
  description="צרו קשר עם פלאזה יזמות והתחדשות עירונית — בדיקת התאמה לפרויקט, מידע נוסף ופגישת היכרות."
>
  <main id="main-content">
  <section class="mx-auto max-w-screen-xl px-6 pb-16 pt-20 md:pb-24 md:pt-28">
    <p class="mb-6 flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded">
      <span class="inline-block h-px w-8 bg-ink/40"></span>
      יצירת קשר
    </p>
    <h1 class="max-w-[18ch] text-balance font-serif text-5xl leading-[0.95] md:text-7xl">
      בואו
      <span class="text-accent">נדבר.</span>
    </h1>
    <p class="mt-8 max-w-[58ch] text-lg leading-relaxed text-faded">
      מעוניינים לשמוע עוד על פרויקטים של התחדשות עירונית? רוצים לבדוק התאמה? צרו קשר ונשמח לענות על כל שאלה.
    </p>
  </section>

  <section class="mx-auto max-w-screen-xl px-6 pb-32">
    <div class="grid gap-16 md:grid-cols-12 md:gap-20">
      <div class="md:col-span-7">
        <form class="space-y-6" action="https://api.web3forms.com/submit" method="POST" data-contact-form>
          <input type="hidden" name="access_key" value="78dc4591-7757-472b-abe6-08aac14d46eb" />
          <input type="hidden" name="subject" value="פנייה חדשה מאתר פלאזה" />
          <input type="hidden" name="from_name" value="פלאזה יזמות — אתר" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" />
          <div class="grid gap-6 sm:grid-cols-2">
            <div class="space-y-2">
              <label for="name" class="text-sm font-medium text-ink">שם מלא</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                maxlength="100"
                placeholder="ישראל ישראלי"
                class="w-full rounded-lg bg-paper px-5 py-4 text-sm text-ink placeholder:text-faded/60 focus:outline-none focus:ring-1 focus:ring-accent"
              />
            </div>
            <div class="space-y-2">
              <label for="phone" class="text-sm font-medium text-ink">טלפון</label>
              <input
                id="phone"
                name="phone"
                type="tel"
                required
                maxlength="20"
                placeholder="050-1234567"
                class="w-full rounded-lg bg-paper px-5 py-4 text-sm text-ink placeholder:text-faded/60 focus:outline-none focus:ring-1 focus:ring-accent"
              />
            </div>
          </div>
          <div class="space-y-2">
            <label for="email" class="text-sm font-medium text-ink">דוא״ל</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder="your@email.com"
              class="w-full rounded-lg bg-paper px-5 py-4 text-sm text-ink placeholder:text-faded/60 focus:outline-none focus:ring-1 focus:ring-accent"
            />
          </div>
          <div class="space-y-2">
            <label for="message" class="text-sm font-medium text-ink">הודעה</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              maxlength="1000"
              placeholder="ספרו לנו על הפרויקט שלכם, מיקום הבניין, מספר יחידות דיור, או כל שאלה אחרת."
              class="w-full resize-none rounded-lg bg-paper px-5 py-4 text-sm text-ink placeholder:text-faded/60 focus:outline-none focus:ring-1 focus:ring-accent"
            ></textarea>
          </div>
          <button
            type="submit"
            class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-accent px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-[var(--gradient-mid)] disabled:opacity-50 sm:w-auto"
            data-contact-button
          >
            שליחת הודעה
          </button>
          <p class="hidden pt-2 text-sm text-accent" data-contact-success aria-live="polite">
            ההודעה נשלחה בהצלחה! נחזור אליכם בהקדם.
          </p>
        </form>
      </div>

      <div class="space-y-10 md:col-span-4 md:col-start-9">
        <div class="space-y-4">
          <h2 class="text-xs font-medium uppercase tracking-widest text-ink">פרטי קשר</h2>
          <ul class="space-y-4 text-sm">
            <li class="flex items-start gap-3 text-faded">
              <span aria-hidden="true" class="mt-0.5 text-accent">📍</span>
              <div>
                <p class="font-medium text-ink">כתובת</p>
                <p>רמת הגולן 6, ירושלים</p>
              </div>
            </li>
            <li class="flex items-start gap-3 text-faded">
              <span aria-hidden="true" class="mt-0.5 text-accent">✉</span>
              <div>
                <p class="font-medium text-ink">דוא״ל</p>
                <a href="mailto:OFFICE@PLAZA-IL.COM" class="transition-colors hover:text-ink">OFFICE@PLAZA-IL.COM</a>
              </div>
            </li>
          </ul>
        </div>

        <div class="space-y-4 border-t border-line pt-8">
          <h2 class="text-xs font-medium uppercase tracking-widest text-ink">שעות פעילות</h2>
          <ul class="space-y-2 text-sm text-faded">
            <li class="flex justify-between">
              <span>ראשון — חמישי</span>
              <span class="text-ink">09:00 — 18:00</span>
            </li>
            <li class="flex justify-between">
              <span>שישי</span>
              <span class="text-ink">09:00 — 13:00</span>
            </li>
            <li class="flex justify-between">
              <span>שבת</span>
              <span class="text-ink">סגור</span>
            </li>
          </ul>
        </div>

        <div class="rounded-[min(1vw,12px)] bg-paper p-6">
          <p class="font-serif text-lg leading-relaxed">
            "ניסיון חזק מאחורינו. שותפות אמיתית לפנינו."
          </p>
          <p class="mt-2 text-xs uppercase tracking-[0.2em] text-faded">— פלאזה יזמות</p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    const form = document.querySelector("[data-contact-form]");
    if (form) {
      const button = form.querySelector("[data-contact-button]");
      const success = form.querySelector("[data-contact-success]");

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        button.disabled = true;
        button.textContent = "שולח...";

        try {
          const response = await fetch("https://api.web3forms.com/submit", {
            method: "POST",
            body: new FormData(form),
          });
          const data = await response.json();

          if (data.success) {
            form.reset();
            success.classList.remove("hidden");
          } else {
            alert("אירעה שגיאה בשליחת ההודעה. אנא נסו שוב.");
          }
        } catch {
          alert("אירעה שגיאה בשליחת ההודעה. אנא נסו שוב.");
        } finally {
          button.disabled = false;
          button.textContent = "שליחת הודעה";
        }
      });
    }
  </script>
  </main>
</BaseLayout>
