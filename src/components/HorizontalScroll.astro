---
interface Props {
  ariaLabel?: string;
  className?: string;
}

const { ariaLabel = "גלילה אופקית", className = "" } = Astro.props;
---

<section
  class:list={["relative", className]}
  data-horizontal-scroll-section
>
  <div class="sticky top-0 flex h-screen items-center overflow-hidden">
    <div
      class="flex w-max items-stretch gap-[clamp(24px,3vw,48px)] px-[max(24px,6vw)]"
      data-horizontal-scroll-track
      role="region"
      aria-label={ariaLabel}
    >
      <slot />
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const section = document.querySelector("[data-horizontal-scroll-section]");
    if (!section) return;

    const track = section.querySelector("[data-horizontal-scroll-track]");
    if (!track) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const isRTL = getComputedStyle(section).direction === "rtl";

    let raf = 0;

    function applyProgress() {
      raf = 0;
      const sectionHeight = section.offsetHeight;
      const viewportHeight = window.innerHeight;
      const scrollable = sectionHeight - viewportHeight;
      if (scrollable <= 0) return;

      const rect = section.getBoundingClientRect();
      const passed = viewportHeight - rect.top;
      const progress = Math.min(1, Math.max(0, passed / scrollable));

      const trackWidth = track.scrollWidth;
      const distance = trackWidth - window.innerWidth;
      if (distance <= 0) return;

      if (prefersReducedMotion) {
        track.style.transform = "";
        return;
      }

      const direction = isRTL ? 1 : -1;
      track.style.transform = `translateX(${direction * progress * distance}px)`;
    }

    function layout() {
      const trackWidth = track.scrollWidth;
      const distance = trackWidth - window.innerWidth;
      const desiredHeight = window.innerHeight + Math.max(distance, 0) + 80;
      section.style.height = `${desiredHeight}px`;
    }

    function onScroll() {
      if (prefersReducedMotion) return;
      if (raf) return;
      raf = requestAnimationFrame(applyProgress);
    }

    layout();
    applyProgress();

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", () => {
      layout();
      applyProgress();
    });
  })();
</script>
